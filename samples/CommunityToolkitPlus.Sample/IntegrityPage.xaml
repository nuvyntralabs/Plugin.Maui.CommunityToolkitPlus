<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityToolkitPlus.Sample.IntegrityPage"
             Title="App Integrity">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Proofs are opaque. Only a backend can verify them. iOS App Attest needs the App Attest entitlement (see Platforms/iOS/Entitlements.plist) and a real device. Android Play Integrity needs a host IIntegrityPlatformAdapter." />
            <Button Text="Show capability" Clicked="OnCapabilityClicked" />
            <Button Text="Create challenge and proof" Clicked="OnCreateProofClicked" />
            <Label x:Name="OutputLabel" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
