<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityToolkitPlus.Sample.ConsentPage"
             Title="Privacy Consent">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Purpose-based legal consent is not the same as OS permission prompts. This package does not guarantee GDPR or CCPA compliance. iOS ATT is requested only when NSUserTrackingUsageDescription is present." />
            <Button Text="Accept analytics" Clicked="OnAcceptAnalyticsClicked" />
            <Button Text="Deny analytics" Clicked="OnDenyAnalyticsClicked" />
            <Button Text="Revoke analytics" Clicked="OnRevokeAnalyticsClicked" />
            <Button Text="Accept personalization" Clicked="OnAcceptPersonalizationClicked" />
            <Button Text="Present consent UI" Clicked="OnPresentClicked" />
            <Button Text="Activate ready SDKs" Clicked="OnActivateClicked" />
            <Label x:Name="OutputLabel" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
