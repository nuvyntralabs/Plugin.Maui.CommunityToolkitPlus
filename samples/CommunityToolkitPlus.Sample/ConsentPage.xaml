<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityToolkitPlus.Sample.ConsentPage"
             Title="Privacy Consent">

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Purpose-based legal consent is not the same as OS permission prompts. This package does not guarantee GDPR or CCPA compliance." />
        <Button Text="Accept analytics" Clicked="OnAcceptClicked" />
        <Button Text="Deny analytics" Clicked="OnDenyClicked" />
        <Button Text="Revoke analytics" Clicked="OnRevokeClicked" />
        <Label x:Name="OutputLabel" LineBreakMode="WordWrap" />
    </VerticalStackLayout>
</ContentPage>
