<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityToolkitPlus.Sample.UpgradePage"
             Title="Upgrade Guard">

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="The startup gate is awaited from App.CreateWindow. SafeMode means migrations failed or startup crashed too many times. AppUpdate installs a binary; Upgrade Guard protects local data after that." />
        <Button Text="Run startup gate" Clicked="OnRunClicked" />
        <Button Text="Show journal and health" Clicked="OnJournalClicked" />
        <Label x:Name="OutputLabel" LineBreakMode="WordWrap" />
    </VerticalStackLayout>
</ContentPage>
