<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunityToolkitPlus.Sample.TrustedTimePage"
             Title="Trusted Time">

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Request trusted time explicitly. This does not replace DateTime.UtcNow." />
        <Button Text="Get trusted UTC" Clicked="OnGetUtcClicked" />
        <Label x:Name="OutputLabel" LineBreakMode="WordWrap" />
    </VerticalStackLayout>
</ContentPage>
